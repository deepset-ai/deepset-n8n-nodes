{
	"name": "@deepset-ai/n8n-nodes-haystack-enterprise-mcp",
	"version": "0.1.1",
	"description": "N8n community node package for using Haystack Enterprise Platform's MCP server as AI Agent tools. Self-hosted n8n only.",
	"license": "MIT",
	"homepage": "https://www.deepset.ai",
	"keywords": [
		"n8n-community-node-package",
		"deepset",
		"haystack",
		"mcp",
		"ai"
	],
	"author": {
		"name": "deepset",
		"email": "haystack@deepset.ai"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/deepset-ai/deepset-n8n-nodes.git",
		"directory": "packages/haystack-enterprise-mcp"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "eslint --no-inline-config nodes credentials package.json && eslint test",
		"lint:fix": "eslint nodes credentials package.json test --fix",
		"test": "vitest run",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": false,
		"credentials": [
			"dist/credentials/HaystackEnterpriseApi.credentials.js",
			"dist/credentials/HaystackEnterpriseOAuth2Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/HaystackEnterpriseMcp/HaystackEnterpriseMcp.node.js"
		]
	},
	"dependencies": {
		"@langchain/core": ">=0.3.0",
		"@modelcontextprotocol/sdk": "^1.32.1",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.53.0",
		"eslint": "9.39.5",
		"prettier": "3.9.10",
		"release-it": "^21.1.1",
		"typescript": "6.0.3",
		"vitest": "^5.0.4"
	},
	"peerDependencies": {
		"n8n-core": "*",
		"n8n-workflow": "*"
	}
}
