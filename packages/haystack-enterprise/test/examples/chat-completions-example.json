      "id": "f7a8b9c0-0007-4f7f-9f7f-000000000007",
      "name": "Merge",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [-680, 0]
    },
    {
      "parameters": {
        "jsCode": "const roleByType = {\n  human: 'user',\n  ai: 'assistant',\n  system: 'system',\n  HumanMessage: 'user',\n  AIMessage: 'assistant',\n  SystemMessage: 'system',\n};\n\nfunction toOpenAiMessages(raw) {\n  if (raw && (raw.human || raw.ai || raw.system)) {\n    const turns = [];\n    if (raw.system) turns.push({ role: 'system', content: raw.system });\n    if (raw.human) turns.push({ role: 'user', content: raw.human });\n    if (raw.ai) turns.push({ role: 'assistant', content: raw.ai });\n    return turns;\n  }\n  const content = raw?.kwargs?.content ?? raw?.content;\n  if (typeof content !== 'string' || content === '') return [];\n  const id = Array.isArray(raw.id) ? raw.id[raw.id.length - 1] : raw.type;\n  return [{ role: roleByType[id] ?? 'user', content }];\n}\n\nconst history = ($json.messages ?? []).flatMap(toOpenAiMessages);\nconst messages = [...history, { role: 'user', content: $json.chatInput }];\n\nreturn [{ json: { ...$json, messages } }];"
      },
      "id": "f7a8b9c0-0008-4f7f-9f7f-000000000008",
      "name": "Build Messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-460, 0]
    },
