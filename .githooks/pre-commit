#!/bin/sh
# Checks formatting of the staged files (Prettier) and lints all packages, like CI does.
# Fix formatting with `npm run format`; skip the hook with `git commit --no-verify`.
files=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$files" ] && exit 0
echo "$files" | tr '\n' '\0' | xargs -0 npx prettier --check --ignore-unknown || {
	echo "Formatting check failed. Run 'npm run format' and stage the changes." >&2
	exit 1
}
npm run lint --silent || {
	echo "Lint failed. Fix the errors above (or run 'npm run lint:fix') and stage the changes." >&2
	exit 1
}
