#!/bin/sh
# Checks the formatting of staged files with Prettier (CI runs the same check).
# Fix a failure with `npm run format`, or skip the hook with `git commit --no-verify`.
files=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$files" ] && exit 0
echo "$files" | tr '\n' '\0' | xargs -0 npx prettier --check --ignore-unknown || {
	echo "Formatting check failed. Run 'npm run format' and stage the changes." >&2
	exit 1
}
